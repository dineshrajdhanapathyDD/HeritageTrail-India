{
  "name": "@heritagetrail/pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ingestion and validation pipeline: Wikidata, OpenStreetMap, Wikimedia Commons and geoBoundaries to per-state GeoJSON.",
