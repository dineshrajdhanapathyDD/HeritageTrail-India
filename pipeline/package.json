    "@turf/point-on-feature": "^7.4.0",
    "@turf/point-to-polygon-distance": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "@turf/truncate": "^7.4.0",
    "fastest-levenshtein": "^1.0.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
