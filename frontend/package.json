{
  "name": "@heritagetrail/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Map-first React frontend for HeritageTrail India (MapLibre GL + Amazon Location Service).",
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "predev": "node scripts/sync-data.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-data.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --maxWorkers=2",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-geo-places": "^3.1160.0",
    "@aws-sdk/client-geo-routes": "^3.1160.0",
    "@aws/amazon-location-utilities-auth-helper": "^1.3.3",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@heritagetrail/shared": "*",
    "@turf/area": "^7.4.0",
    "@turf/circle": "^7.4.0",
    "framer-motion": "^14.8.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
