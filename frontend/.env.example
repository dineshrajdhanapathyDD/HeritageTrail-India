# Optional local overrides. Copy to .env.local (gitignored). Leave empty for local mode:
# the app then uses the built-in no-tile basemap and disables routing and place search.
# After deploy, /config.json from CloudFront supplies these values at runtime; never put AWS credentials here.

# Amazon Location API key (restricted to geo-maps/geo-places/geo-routes read actions and allowed referers)
VITE_LOCATION_API_KEY=
# Region of the Amazon Location API key (default us-east-1)
VITE_AWS_REGION=
# Amazon Location map style: Standard | Monochrome | Hybrid | Satellite (default Standard)
VITE_MAP_STYLE=
# Base URL of the HeritageTrail REST API (only needed for AI summaries), e.g. https://xxxx.execute-api.us-east-1.amazonaws.com/dev
VITE_API_BASE_URL=
# true to show the AI summary button (requires VITE_API_BASE_URL)
VITE_SUMMARIES_ENABLED=
