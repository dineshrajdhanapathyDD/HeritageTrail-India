{
  "name": "@heritagetrail/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AWS CDK (TypeScript) app for HeritageTrail India. Synth only until deployment is approved.",
  "scripts": {
    "cdk": "cdk",
    "synth": "cdk synth -c env=dev --quiet",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --maxWorkers=2 --passWithNoTests",
    "check:region": "tsx scripts/check-region.ts"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock": "^3.1160.0",
    "@aws-sdk/client-geo-maps": "^3.1160.0",
    "@aws-sdk/client-geo-places": "^3.1160.0",
    "@aws-sdk/client-geo-routes": "^3.1160.0",
    "@aws-sdk/client-location": "^3.1160.0",
    "@aws-sdk/client-sts": "^3.1160.0",
    "@types/node": "^22.20.5",
    "aws-cdk": "^2.1146.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
