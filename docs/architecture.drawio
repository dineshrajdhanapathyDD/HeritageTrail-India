<mxfile host="app.diagrams.net" agent="Kiro" version="24.0.0">
  <diagram id="heritagetrail-architecture" name="HeritageTrail India architecture">
    <mxGraphModel dx="1700" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;HeritageTrail India - Architecture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Stack HeritageTrail-dev, us-east-1, deployed with AWS CDK (TypeScript)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#7A2E1D;" vertex="1" parent="1">
